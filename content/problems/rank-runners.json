  "referenceSolution": "def rank_runners(runners):\n    ordered = sorted(runners, key=lambda runner: (runner[\"seconds\"], runner[\"name\"]))\n    return [runner[\"name\"] for runner in ordered]",
  "solution": {
    "code": "def rank_runners(runners):\n    ordered = sorted(runners, key=lambda runner: (runner[\"seconds\"], runner[\"name\"]))\n    return [runner[\"name\"] for runner in ordered]",
    "explanation": "Sort by a tuple containing elapsed time and then runner name. Tuple ordering applies the name only when two times tie. Returning names keeps the output focused on the requested ranking."
  },
