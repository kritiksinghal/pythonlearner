  "description": "Each sale is a pair `[store_name, cents]`. Return a dictionary containing the sum of cents for every store. Preserve stores with zero-value sales.",
  "starterCode": "def sales_by_store(sales):\n    # Return total cents grouped by store\n    pass\n",
  "referenceSolution": "def sales_by_store(sales):\n    totals = {}\n    for store, cents in sales:\n        totals[store] = totals.get(store, 0) + cents\n    return totals",
  "solution": {
    "code": "def sales_by_store(sales):\n    totals = {}\n    for store, cents in sales:\n        totals[store] = totals.get(store, 0) + cents\n    return totals",
    "explanation": "Accumulate each sale into a dictionary entry keyed by store. get supplies zero for the first sale, and later records add to the same running total. The input records remain unchanged."
  },
  "wrongSolutions": [
    "def sales_by_store(sales):\n    return {store:cents for store,cents in sales}",
    "def sales_by_store(sales):\n    totals = {}\n    for store, cents in sales:\n        totals.setdefault(store, cents)\n    return totals"
  ],
